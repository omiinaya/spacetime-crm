root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml,json}]
indent_size = 2

[*.{js,ts,tsx,jsx,css,scss,html,md}]
indent_size = 2

[*.{sh,bash,zsh}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{py,rs,go,java,kt,swift}]
indent_size = 4

[*.toml]
indent_size = 2
