# ── SpacetimeCRM Production Environment ─────────────────────
# Copy to .env and fill in values before deploying:
#   cp deploy/.env.prod.example .env
#   vi .env
#
# IMPORTANT: Set JWT_SECRET to a long random string before deploying!

# SpacetimeDB
STDB_HOST=spacetime
STDB_PORT=3001
STDB_DB=spacetime-crm

# Backend
SERVER_PORT=8723

# CORS origin must match the nginx proxy URL
CORS_ORIGIN=https://spacetime-crm.local

# App URL (for links in emails, portal, etc.)
APP_URL=https://spacetime-crm.local

# JWT — CHANGE THIS! Generate with: openssl rand -hex 32
JWT_SECRET=set-via-environment-variable

# Optional: session expiry in hours (default: 24)
JWT_EXPIRE_HOURS=24

# Logging
LOG_LEVEL=info
WORKERS=4

# Stripe (optional — leave blank if not using payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (SMTP — optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@spacetime-crm.local

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
