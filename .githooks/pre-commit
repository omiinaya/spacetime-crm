#!/bin/sh
# Pre-commit hook — run lint checks before every commit
# Installed via: make setup-git-hooks

echo "🔍 Running pre-commit checks..."

# Check for unformatted code
if [ -f Makefile ]; then
  if grep -q '^fmt:' Makefile; then
    echo "  Running fmt check..."
    # fmt-check is non-mutating: it reports unformatted code without touching
    # the working tree. If it fails, the author must run `make fmt` and re-stage
    # — the hook must NOT auto-modify staged files (that produced dirty previews
    # and recurring "style" commits after every real commit).
    if grep -q '^fmt-check:' Makefile; then
      if ! make fmt-check >/dev/null 2>&1; then
        echo "❌ Formatting not clean. Run 'make fmt' then re-stage your changes and commit again."
        exit 1
      fi
    else
      make fmt 2>/dev/null
    fi
  fi
  if grep -q '^lint:' Makefile; then
    echo "  Running lint check..."
    make lint 2>/dev/null || true
  fi
fi

# Check that AGENTS.md exists
if [ ! -f AGENTS.md ]; then
  echo "⚠️  WARNING: AGENTS.md is missing — consider adding it"
fi

# Check for debug artifacts
if git diff --cached --name-only | grep -q '\.only\|console\.log\|dbg!'; then
  echo "⚠️  WARNING: Found possible debug artifacts (.only, console.log, dbg!)"
fi

echo "✅ Pre-commit checks complete"
