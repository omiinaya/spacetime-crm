# pragma: allowlist secret
node_modules/
dist/
target/
__pycache__/
*.pyc
.env
*.lock
*.tsbuildinfo
.spacetime-version
*_settings.json

# Playwright E2E test artifacts
web/playwright-report/
web/test-results/
web/.auth/

# SpacetimeDB config dir that sometimes gets created literally
~/

# Virtual environment
server/.venv/

# Secret files and credentials
*.env.local
*.env.prod
*.env.*.local
*.pem
*.key
*.cert
credentials*
*.secret
secrets.yml

# Backup files
backups/

# coverage reports
web/coverage/

# Additional secret file patterns
*.env.*
*.cover
*.coverage
