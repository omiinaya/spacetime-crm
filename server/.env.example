STDB_HOST=localhost
STDB_PORT=3001
STDB_DB=spacetime-crm
SERVER_PORT=8723
CORS_ORIGIN=http://localhost:5185

# hermes-id DID auth (mirrors spacetime-kanban did_auth.py — fail-open when unset)
HERMES_AUTH_SERVER_URL=http://192.168.1.68:9488
HERMES_AUTH_PROJECT=crm

# Structured JSON logging (ROADMAP 9A-5)
# LOG_LEVEL: one of debug|info|warning|error|critical (default: info)
LOG_LEVEL=info
# STRUCTURED_LOGGING: true emits JSON lines to stderr, false keeps human-readable text
STRUCTURED_LOGGING=false
