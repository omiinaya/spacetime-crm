# ── Test Build Stage ────────────────────────────────────────────────
# Separate stage to build frontend (reuses production logic)
FROM node:22-alpine AS frontend-builder
WORKDIR /app/web
COPY web/package.json web/package-lock.json* ./
RUN npm ci
COPY web/ ./
RUN npm run build

# ── Test Runtime Stage ──────────────────────────────────────────────
# Includes all production deps + test dependencies (pytest, httpx, etc.)
FROM python:3.12-slim AS test-runtime

# System deps: curl for health checks, playwright deps for any browser tests
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/server

# Install Python dependencies including test deps
COPY server/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Install test dependencies
RUN pip install --no-cache-dir \
    pytest \
    pytest-asyncio \
    httpx \
    pytest-cov \
    ruff

# Install Playwright Chromium for any browser-based tests
RUN python3 -m playwright install chromium --with-deps 2>&1 | tail -5

# Install spacetime CLI for module publishing
RUN curl -L -o /tmp/spacetime.tar.gz \
    "https://github.com/clockworklabs/SpacetimeDB/releases/download/v2.6.1/spacetime-x86_64-unknown-linux-gnu.tar.gz" && \
    tar xzf /tmp/spacetime.tar.gz -C /usr/local/bin/ && \
    rm /tmp/spacetime.tar.gz && \
    if [ -f /usr/local/bin/spacetimedb-cli ] && [ ! -f /usr/local/bin/spacetime ]; then \
      mv /usr/local/bin/spacetimedb-cli /usr/local/bin/spacetime; \
    fi && \
    chmod +x /usr/local/bin/spacetime

# Copy server source code
COPY server/ ./

# Copy frontend dist from builder stage
COPY --from=frontend-builder /app/web/dist /app/web/dist

# Copy test entrypoint script
COPY scripts/test-entrypoint.sh /test-entrypoint.sh
RUN chmod +x /test-entrypoint.sh

EXPOSE 8723

# Test entrypoint: waits for STDB, publishes module, starts backend
ENTRYPOINT ["/test-entrypoint.sh"]